<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version><relativePath/>
    </parent>
    <groupId>com.company</groupId>
    <artifactId>company-order-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>企业独立订单服务示例</name>
    <properties>
        <java.version>17</java.version>
        <forgex.version>1.0.0</forgex.version>
        <sample.platform-api-on-classpath>false</sample.platform-api-on-classpath>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.forgex</groupId><artifactId>forgex-common-bom</artifactId>
                <version>${forgex.version}</version><type>pom</type><scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>com.forgex</groupId><artifactId>forgex-common-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <sample.platform-api-on-classpath>${sample.platform-api-on-classpath}</sample.platform-api-on-classpath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>platform-api</id>
            <properties><sample.platform-api-on-classpath>true</sample.platform-api-on-classpath></properties>
            <dependencies>
                <dependency><groupId>com.forgex</groupId><artifactId>Forgex_Sys_Api</artifactId><version>${forgex.version}</version></dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
                        <executions>
                            <execution><id>platform-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
                                <configuration><sources><source>src/platform-api/java</source></sources></configuration>
                            </execution>
                            <execution><id>platform-test</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
                                <configuration><sources><source>src/platform-api-test/java</source></sources></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

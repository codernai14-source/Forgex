package ${ctx.packageName}.domain.vo;

import com.forgex.common.base.BaseEntity;
import com.forgex.common.dict.DictI18n;
<% for(importItem in imports){ %>
import ${importItem};
<% } %>
import lombok.Data;
import lombok.EqualsAndHashCode;

/**
 * ${ctx.subTableComment} VO
 *
 * @author ${ctx.author}
 * @since ${ctx.date}
 */
@Data
@EqualsAndHashCode(callSuper = true)
public class ${ctx.subEntityName}VO extends BaseEntity {
<% for(column in ctx.subColumns){ if(!column.isBaseField){ %>

    /**
     * ${column.columnComment!column.columnName}
     */
<% if(column.optionSourceType == "DICT" && column.dictCode != null && column.dictCode != ""){ %>
    @DictI18n(nodePathConst = "${column.dictCode}", targetField = "${column.javaFieldName}Text")
<% } %>
    private ${column.javaType} ${column.javaFieldName};
<% if(column.optionSourceType == "DICT" && column.dictCode != null && column.dictCode != ""){ %>

    /**
     * ${column.columnComment!column.columnName} text
     */
    private String ${column.javaFieldName}Text;
<% } %>
<% }} %>
}

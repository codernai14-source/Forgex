<template>
  <div class="${ctx.entityNameLower}-page">
    <FxDynamicTable
      ref="tableRef"
      :table-code="'${ctx.mainTableCode}'"
      :request="handleRequest"
      :dynamic-table-config="tableConfig"
      :show-query-form="true"
      :row-selection="rowSelection"
    >
      <template #toolbar>
        <a-space :size="8">
          <a-button v-permission="'${ctx.permKeyPrefix}:batchDelete'" danger :disabled="!selectedCount" @click="handleBatchDelete">批量删除</a-button>
          <a-button v-permission="'${ctx.permKeyPrefix}:add'" type="primary" @click="openCreate">新增</a-button>
        </a-space>
      </template>
      <template #action="{ record }">
        <a-space>
          <a v-permission="'${ctx.permKeyPrefix}:query'" @click="openDetail(record)">详情</a>
          <a v-permission="'${ctx.permKeyPrefix}:edit'" @click="openEdit(record)">编辑</a>
          <a v-permission="'${ctx.permKeyPrefix}:delete'" style="color: #ff4d4f" @click="handleDelete(record.id)">删除</a>
        </a-space>
      </template>
    </FxDynamicTable>

    <${ctx.entityName}FormDialog
      v-model:open="formVisible"
      :record-id="currentId"
      :readonly="formReadonly"
      @success="handleDialogSuccess"
    />
  </div>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { Modal } from 'ant-design-vue'
import FxDynamicTable from '@/components/common/FxDynamicTable.vue'
import { useBatchTableSelection } from '@/hooks/useBatchTableSelection'
import { page${ctx.entityName}, delete${ctx.entityName}, batchDelete${ctx.entityName} } from '@/api/${ctx.moduleName}/${ctx.entityNameLower}'
import ${ctx.entityName}FormDialog from './components/${ctx.entityName}FormDialog.vue'

const tableRef = ref()
const { selectedRowKeys, selectedCount, rowSelection, clearSelection } = useBatchTableSelection<number>()
const formVisible = ref(false)
const currentId = ref<number>()
const formReadonly = ref(false)

const tableConfig = computed(() => ({
  tableCode: '${ctx.mainTableCode}',
  tableName: '${ctx.menuName}',
  tableType: 'NORMAL',
  rowKey: 'id',
  defaultPageSize: 20,
  columns: [
<% for(column in ctx.mainTableColumns){ %>
    { field: '${column.javaFieldName}', title: '${column.columnComment!column.columnName}', width: ${column.width}, align: '${column.align}' },
<% } %>
    { field: 'action', title: '操作', width: 180, align: 'center' },
  ],
  queryFields: [
<% for(column in ctx.mainQueryColumns){ %>
    { field: '${column.javaFieldName}', label: '${column.columnComment!column.columnName}', queryType: '${column.queryType}', queryOperator: '${column.queryOperator}' },
<% } %>
  ],
  version: 1,
}))

const handleRequest = async (payload: any) => {
  const result = await page${ctx.entityName}({
    pageNum: payload.page.current,
    pageSize: payload.page.pageSize,
    ...payload.query,
  })
  return { records: result.records || [], total: result.total || 0 }
}

function openCreate() {
  currentId.value = undefined
  formReadonly.value = false
  formVisible.value = true
}

function openEdit(record: any) {
  currentId.value = record.id
  formReadonly.value = false
  formVisible.value = true
}

function openDetail(record: any) {
  currentId.value = record.id
  formReadonly.value = true
  formVisible.value = true
}

function handleDialogSuccess() {
  tableRef.value?.refresh?.()
}

function handleDelete(id: number) {
  Modal.confirm({
    title: '确认删除',
    content: '确定要删除这条记录吗？',
    onOk: async () => {
      await delete${ctx.entityName}(id)
      tableRef.value?.refresh?.()
    },
  })
}

function handleBatchDelete() {
  if (!selectedCount.value) return
  Modal.confirm({
    title: '确认批量删除',
    content: '确定要删除选中的 ' + selectedCount.value + ' 条数据吗？',
    onOk: async () => {
      await batchDelete${ctx.entityName}(selectedRowKeys.value)
      clearSelection()
      tableRef.value?.refresh?.()
    },
  })
}
</script>

<style scoped lang="less" src="@/styles/views/${ctx.moduleName}/${ctx.entityNameLower}/index.less"></style>

<template>
  <div class="${ctx.subEntityNameLower}-detail-page">
    <FxDynamicTable
      ref="tableRef"
      :table-code="'${ctx.subTableCode}'"
      :request="handleRequest"
      :dynamic-table-config="tableConfig"
      :dict-options="dictOptions"
      :show-query-form="false"
    >
      <template #toolbar>
        <a-space :size="8">
          <a-button v-permission="'${ctx.permKeyPrefix}:subCreate'" type="primary" @click="openCreate">新增</a-button>
        </a-space>
      </template>
      <template #action="{ record }">
        <a-space>
          <a v-permission="'${ctx.permKeyPrefix}:subDetail'" @click="openDetail(record)">详情</a>
          <a v-permission="'${ctx.permKeyPrefix}:subUpdate'" @click="openEdit(record)">编辑</a>
          <a v-permission="'${ctx.permKeyPrefix}:subDelete'" style="color: #ff4d4f" @click="handleDelete(record.id)">删除</a>
        </a-space>
      </template>
    </FxDynamicTable>

    <${ctx.subEntityName}FormDialog
      v-model:open="formVisible"
      :record-id="currentId"
      :main-id="mainId"
      :readonly="formReadonly"
      @success="handleDialogSuccess"
    />
  </div>
</template>

<script setup lang="ts">
import { computed, ref } from 'vue'
import { useRoute } from 'vue-router'
import { Modal } from 'ant-design-vue'
import FxDynamicTable from '@/components/common/FxDynamicTable.vue'
import { useDict } from '@/hooks/useDict'
import { page${ctx.subEntityName}, delete${ctx.subEntityName} } from '@/api/${ctx.moduleName}/${ctx.subEntityNameLower}'
import ${ctx.subEntityName}FormDialog from './components/${ctx.subEntityName}FormDialog.vue'

const route = useRoute()
const tableRef = ref()
const formVisible = ref(false)
const formReadonly = ref(false)
const currentId = ref<number>()
const mainId = computed(() => Number(route.params.id))
const dictItemRefs: Record<string, any> = {
<% for(dictCode in ctx.subDictCodes){ %>
  '${dictCode}': useDict('${dictCode}').dictItems,
<% } %>
}

const dictOptions = computed(() => ({
<% for(dictCode in ctx.subDictCodes){ %>
  '${dictCode}': dictItemRefs['${dictCode}'].value,
<% } %>
}))

const tableConfig = computed(() => ({
  tableCode: '${ctx.subTableCode}',
  tableName: '${ctx.subTableComment}',
  tableType: 'NORMAL',
  rowKey: 'id',
  defaultPageSize: 20,
  columns: [
<% for(column in ctx.subTableColumns){ %>
    { field: '${column.javaFieldName}', title: '${column.columnComment!column.columnName}', width: ${column.width}, align: '${column.align}'<% if(column.optionSourceType == "DICT" && column.dictCode != null && column.dictCode != ""){ %>, dictCode: '${column.dictCode}'<% } %> },
<% } %>
    { field: 'action', title: '操作', width: 180, align: 'center' },
  ],
  queryFields: [],
  version: 1,
}))

const handleRequest = async (payload: any) => {
  const result = await page${ctx.subEntityName}({
    pageNum: payload.page.current,
    pageSize: payload.page.pageSize,
    ${ctx.entityNameLower}Id: mainId.value,
  })
  return { records: result.records || [], total: result.total || 0 }
}

function openCreate() {
  currentId.value = undefined
  formReadonly.value = false
  formVisible.value = true
}

function openEdit(record: any) {
  currentId.value = record.id
  formReadonly.value = false
  formVisible.value = true
}

function openDetail(record: any) {
  currentId.value = record.id
  formReadonly.value = true
  formVisible.value = true
}

function handleDialogSuccess() {
  tableRef.value?.refresh?.()
}

function handleDelete(id: number) {
  Modal.confirm({
    title: '确认删除',
    content: '确定要删除这条记录吗？',
    onOk: async () => {
      await delete${ctx.subEntityName}(id)
      tableRef.value?.refresh?.()
    },
  })
}
</script>

<style scoped lang="less" src="@/styles/views/${ctx.moduleName}/${ctx.entityNameLower}/detail.less"></style>

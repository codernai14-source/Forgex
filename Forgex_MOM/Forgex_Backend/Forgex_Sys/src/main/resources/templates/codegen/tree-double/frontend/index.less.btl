.${ctx.entityNameLower}-page {
  height: 100%;
}

.tree-panel {
  min-height: 520px;
  padding-right: 12px;
  border-right: 1px solid var(--fx-border-color, #f0f0f0);
}

.tree-panel__title {
  margin-bottom: 12px;
  color: var(--fx-text-primary, #1f2937);
  font-size: 16px;
  font-weight: 600;
}

.tree-empty-tip {
  margin-bottom: 12px;
}
